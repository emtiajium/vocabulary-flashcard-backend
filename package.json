{
    "name": "vocabulary-flashcard-backend",
    "version": "1.61.0",
    "author": {
        "name": "Emtiaj Hasan",
        "email": "271emtiaj@gmail.com",
        "url": "https://www.linkedin.com/in/emtiajium/"
    },
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "create:env": "node -r fs -e \"fs.copyFileSync('.env.sample', '.env', fs.constants.COPYFILE_EXCL)\"",
        "prebuild": "rimraf dist",
        "build": "nest build",
        "format": "prettier --write \"{.github,migrations,practice,src,test}/*.{html,sql,ts,yml}\" \"*.{md,json,mjs,mts,yml}\"",
        "format:check": "prettier --check \"{.github,migrations,practice,src,test}/*.{html,sql,ts,yml}\" \"*.{md,json,mjs,mts,yml}\"",
        "start:dev": "nest start --watch",
        "start:prod": "npm run migration:run && npm run build && node dist/src/main.js",
        "lint": "eslint \"{migrations,src,test}/**/*.ts\" --fix",
        "lint:check": "eslint \"{migrations,src,test}/**/*.ts\"",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --detectOpenHandles",
        "test:memory-usage": "LOGGING_CONSOLE_ENABLED=false node --experimental-vm-modules --expose-gc ./node_modules/.bin/jest --logHeapUsage --runInBand --coverage=false --detectOpenHandles --forceExit --detectLeaks",
        "typeorm": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/.bin/typeorm",
        "migration:generate": "node -r ts-node/register -r tsconfig-paths/register src/common/persistence/MigrationGenerationHandler.ts",
        "migration:run:local-dev": "npm run typeorm migration:run -- -d ./src/common/persistence/TypeormConfig.ts",
        "migration:run:local-test": "TYPEORM_PORT=5429 npm run typeorm migration:run -- -d ./src/common/persistence/TypeormConfig.ts",
        "migration:run": "npm run migration:run:local-test && npm run migration:run:local-dev",
        "migration:run:aeb": "npm run typeorm migration:run -- -d ./src/common/persistence/TypeormConfig.ts",
        "migration:revert:local-dev": "npm run typeorm migration:revert -- -d ./src/common/persistence/TypeormConfig.ts",
        "migration:revert:local-test": "TYPEORM_PORT=5429 npm run typeorm migration:revert -- -d ./src/common/persistence/TypeormConfig.ts",
        "migration:revert": "npm run migration:revert:local-test && npm run migration:revert:local-dev",
        "ci": "npx tsc --noEmit --incremental false && npm run format:check && npm run lint:check && npm run test && npm run build",
        "seed-script:insert-test-users": "node -r ts-node/register -r tsconfig-paths/register src/manual-scripts/CreateTestUsers.ts",
        "clean:docker-dev-containers": "docker kill ielts-gibberish-postgres; docker stop ielts-gibberish-postgres; docker rm ielts-gibberish-postgres; docker volume rm ielts-gibberish-postgres-data",
        "clean:docker-test-containers": "docker kill ielts-gibberish-test-postgres; docker stop ielts-gibberish-test-postgres; docker rm ielts-gibberish-test-postgres; docker volume rm ielts-gibberish-test-postgres-data",
        "clean:docker-containers": "npm run clean:docker-test-containers; npm run clean:docker-dev-containers"
    },
    "dependencies": {
        "@nestjs/axios": "^12.0.0",
        "@nestjs/cli": "^12.0.0",
        "@nestjs/common": "^12.0.0",
        "@nestjs/config": "^12.0.0",
        "@nestjs/core": "^12.0.0",
        "@nestjs/platform-express": "^12.0.0",
        "@nestjs/schedule": "^12.0.0",
        "@nestjs/swagger": "^12.0.0",
        "@nestjs/terminus": "^12.0.0",
        "@nestjs/typeorm": "^12.0.0",
        "@types/express": "^5.0.6",
        "axios": "1.21.1",
        "body-parser": "2.4.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "cookie-parser": "^1.4.7",
        "date-fns": "^4.4.0",
        "dotenv": "^17.2.4",
        "express": "^5.2.1",
        "express-basic-auth": "^1.2.1",
        "fast-safe-stringify": "^2.0.7",
        "google-auth-library": "^10.5.0",
        "jose": "^6.2.18",
        "jsonwebtoken": "9.0.3",
        "lodash": "^4.18.1",
        "pg": "^8.18.0",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.1.2",
        "rxjs": "7.8.2",
        "swagger-ui-express": "^5.0.1",
        "tsconfig-paths": "^4.2.0",
        "typeorm": "1.1.0",
        "uuid": "^14.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@nestjs/schematics": "^12.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/lodash": "^4.14.170",
        "@types/node": "^26.6.6",
        "@types/supertest": "^6.0.2",
        "@types/uuid": "^10.0.0",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-unicorn": "^79.0.0",
        "jest": "^30.5.2",
        "jest-junit": "^17.0.0",
        "jiti": "^2.6.1",
        "prettier": "^3.10.1",
        "prettier-plugin-embed": "^0.8.2",
        "prettier-plugin-sql": "^0.20.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.3.2",
        "ts-jest": "^29.4.15",
        "ts-loader": "^9.6.2",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2"
    },
    "jest": {
        "collectCoverage": true,
        "coverageDirectory": "./coverage",
        "collectCoverageFrom": [
            "src/**/*.ts",
            "!src/main.ts",
            "!test/**/*"
        ],
        "maxWorkers": 1,
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "moduleNameMapper": {
            "^@/(.*)": "<rootDir>/src/$1",
            "^@test/(.*)": "<rootDir>/test/$1",
            "^@root/(.*)": "<rootDir>/$1"
        },
        "reporters": [
            "default",
            [
                "jest-junit",
                {
                    "outputDirectory": "./coverage"
                }
            ]
        ],
        "rootDir": ".",
        "setupFiles": [
            "<rootDir>/test/jest-init.ts"
        ],
        "testEnvironment": "node",
        "testMatch": [
            "<rootDir>/test/{e2e,integration,unit}/**/*.ts"
        ],
        "testTimeout": 5000,
        "transform": {
            "^.+\\.(t|j)s$": [
                "ts-jest",
                {
                    "diagnostics": false
                }
            ]
        },
        "verbose": true
    }
}
