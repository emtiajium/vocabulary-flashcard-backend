{
    "compilerOptions": {
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "incremental": true,
        "module": "commonjs",
        "noImplicitAny": true,
        "outDir": "./dist",
        "paths": {
            "@/*": ["./src/*"],
            "@root/*": ["./*"],
            "@test/*": ["./test/*"]
        },
        "removeComments": true,
        "resolveJsonModule": true,
        "sourceMap": true,
        "strict": true,
        "strictNullChecks": false,
        "strictPropertyInitialization": false,
        "target": "es2020",
        "types": ["node", "jest"]
    }
}
